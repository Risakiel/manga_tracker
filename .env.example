# Copy this file to .env (local run) or set these as environment variables
# in docker-compose.yml / the Unraid container template.

# Base URL of your Suwayomi Server instance, no trailing slash, no /api/graphql suffix.
SUWAYOMI_URL=http://192.168.1.41:4567

# Only needed if you enabled Basic Auth on Suwayomi.
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=

# Base URL of your Komga instance, and an API key (Komga: Settings > API
# Keys, needs an ADMIN-role account). Leave both empty to disable the Komga
# integration entirely (read progress, metadata push, "View on Komga" link).
KOMGA_URL=http://192.168.1.90:25600
KOMGA_API_KEY=

# How often to re-sync each manga against MangaUpdates / reconcile with
# Suwayomi / Komga.
SYNC_INTERVAL_HOURS=24
SUWAYOMI_SYNC_INTERVAL_HOURS=24
KOMGA_SYNC_INTERVAL_HOURS=24
ENABLE_SCHEDULER=true

# Container-side path where the NAS share (read-only bind mount, see
# docker-compose.yml) is expected to be mounted. Must contain exactly two
# subdirectories: "Manga" and "Pornhwa". Leave the mount out entirely if you
# don't want this feature -- the "Dossier serveur" field just falls back to
# free text.
LIBRARY_ROOT=/library
